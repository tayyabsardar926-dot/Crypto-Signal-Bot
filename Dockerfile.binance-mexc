FROM python:3.12-slim
WORKDIR /app
COPY binance-mexc-dashboard/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY binance-mexc-dashboard/app.py ./app.py
COPY binance-mexc-dashboard/index.html ./index.html
CMD ["sh","-c","exec gunicorn -w 2 -b 0.0.0.0:${PORT:-8080} --timeout 180 app:app"]
